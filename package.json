{
  "name": "pit-wall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Multi-window race replay pit wall built on OpenF1 data (unofficial fan project)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "ingest": "tsx server/cli-ingest.ts",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts --production",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "publish:data": "tsx server/publish.ts",
    "build:hosted": "VITE_HOSTED=1 vite build && node scripts/copy-site-data.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@types/three": "^0.186.0",
    "fastify": "^5.12.7",
    "firebase": "^13.1.0",
    "mqtt": "^5.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "web-push": "^3.6.7"
  }
}
